{
    "name": "serendipity_hq/bundle-commands-queues",
    "description": "Manage queues of commands and processes them in your Symfony app.",
    "type": "symfony-bundle",
    "keywords": [
        "cronjob",
        "cronjobs",
        "queues",
        "threading"
    ],
    "homepage": "https://github.com/Aerendir/bundle-commands-queues",
    "license": "MIT",
    "support": {
        "docs": "https://github.com/Aerendir/bundle-commands-queues/tree/dev/docs",
        "issues": "https://github.com/Aerendir/bundle-commands-queues/issues"
    },
    "authors": [
        {
            "name": "Adamo Aerendir Crespi",
            "email": "hello@aerendir.me"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pcntl": "*",
        "doctrine/collections": "^2.2",
        "doctrine/dbal": "^3.8.2 || ^4.0",
        "doctrine/doctrine-bundle": "^2.14 || ^3.0",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^3.3.1 || ^4.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "sensiolabs/ansi-to-html": "^1.2 || ^2.0",
        "serendipity_hq/component-console-styles": "dev-dev",
        "serendipity_hq/component-then-when": "^2.0.3",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/process": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.4",
        "phpstan/phpstan": "2.3.5",
        "phpstan/phpstan-doctrine": "2.1.2",
        "phpstan/phpstan-phpunit": "2.1.2",
        "phpstan/phpstan-symfony": "2.1.1",
        "rector/rector": "2.8.5",
        "roave/security-advisories": "dev-master",
        "serendipity_hq/rector-config": "1.1.23",
        "sonata-project/admin-bundle": "^4.43",
        "sonata-project/doctrine-orm-admin-bundle": "^4.20",
        "symfony/routing": "^6.4 || ^7.4 || ^8.0",
        "symfony/var-dumper": "^6.4 || ^7.4 || ^8.0",
        "twig/twig": "^3.15"
    },
    "suggest": {
        "sonata-project/admin-bundle": "Allows to view what's going on with your queues and commands jobs using automatic integration with SonataAdminBundle.",
        "sonata-project/doctrine-orm-admin-bundle": "Required, together with sonata-project/admin-bundle, by the SonataAdminBundle integration."
    },
    "autoload": {
        "psr-4": {
            "SerendipityHQ\\Bundle\\CommandsQueuesBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SerendipityHQ\\Bundle\\CommandsQueuesBundle\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "symfony/flex": true
        }
    },
    "scripts": {
        "bin": "echo 'bin not installed'",
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all update --ansi"
        ]
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false
        }
    }
}
